# PostgreSQL connection used by the FastAPI backend (see backend/app/database.py).
# With the PostGIS container from docker/compose.yaml running:
DATABASE_URL=postgresql+psycopg2://culture:culture@localhost:5432/culture

# Frontend API base URL (see frontend/src/api/client.ts). Leave unset to use the
# relative '/api' endpoint, which works with the Vite proxy (dev/preview) or when
# the backend serves the built frontend. Set an absolute URL only when the site is
# hosted on a separate origin, e.g.:
# VITE_API_BASE=https://api.example.com/api