# Frontend Supabase Auth API Keys (Vite)
# Obtain from Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Backend API base URL (defaults to "/api" which proxies to the backend)
# VITE_API_BASE=http://127.0.0.1:8000/api

# Optional: Extra admin emails checked by the client for the admin UI
# Supports a single email or a comma-separated list (case-insensitive)
# VITE_ADMIN_EMAIL=admin@example.com
