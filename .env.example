# PostgreSQL connection used by the FastAPI backend (see backend/app/database.py).
# With the PostGIS container from docker/compose.yaml running, use:
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/DBNAME

# Supabase Auth Configuration
# Obtain from Supabase Dashboard -> Settings -> API
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings-api

# Supabase project URL. Required on projects that sign access tokens with
# asymmetric keys (ES256/RS256), which is the current default for new projects.
# The backend reads the signing key from <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# and picks the algorithm from each token's own header.
SUPABASE_URL=https://your-project-id.supabase.co
# Optional explicit override if your JWKS lives elsewhere.
# SUPABASE_JWT_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Backend admin authorization whitelist (case-insensitive; comma-separated list supported)
ADMIN_EMAILS=admin@example.com
# Optional client-side hint so the admin nav appears immediately after sign-in.
# The portal is gated on GET /api/admin/session, which evaluates ADMIN_EMAILS and
# the role claims from a verified token, so this never grants access on its own.
# VITE_ADMIN_EMAIL=admin@example.com

# Supabase Storage (Documents section) — used by scripts/upload_documents_to_supabase.py
# SUPABASE_SECRET_KEY is Supabase's modern elevated server-side key (sb_secret_...),
# available from Supabase Dashboard -> Project Settings -> API Keys.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Bucket backing the media library. GET /api/admin/health reports "Not configured"
# when this is empty, so the admin status panel never claims a working bucket.
# SUPABASE_STORAGE_BUCKET=heritage-media
# Legacy fallbacks (in order of preference): SUPABASE_SERVICE_ROLE_KEY
# (service_role sb_secret...), SUPABASE_STORAGE_KEY, SUPABASE_ANON_KEY.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend Supabase API Keys (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key