# PostgreSQL connection used by the FastAPI backend (see backend/app/database.py).
# With the PostGIS container from docker/compose.yaml running, use:
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/DBNAME

# Supabase Auth Configuration
# Obtain from Supabase Dashboard -> Settings -> API
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings-api
ADMIN_EMAILS=admin@example.com

# Frontend Supabase API Keys (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key